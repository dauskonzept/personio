mod.wizards.newContentElement.wizardItems.plugins {
	elements {
		personio_list {
			iconIdentifier = ext-personio-element-list
			title = LLL:personio.be:element_personio_list_title
			description = LLL:personio.be:element_personio_list_description

			tt_content_defValues {
				CType = personio_list
			}
		}

		personio_show {
			iconIdentifier = ext-personio-element-show
			title = LLL:personio.be:element_personio_show_title
			description = LLL:personio.be:element_personio_show_description

			tt_content_defValues {
				CType = personio_show
			}
		}
	}
}
